# Supabase (Banco de Dados PostgreSQL, Auth e Storage)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica-com-rls"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-apenas-servidor"

# Informações Comerciais Oficiais do Estabelecimento
NEXT_PUBLIC_STORE_NAME="BRASA CAIPIRA"
NEXT_PUBLIC_STORE_SLOGAN="O verdadeiro sabor da brasa."
NEXT_PUBLIC_WHATSAPP_NUMBER="5519998107666"
NEXT_PUBLIC_STORE_ADDRESS="Rua dos Crisantemos, 350 — Jardim Nova Leme — Leme/SP"
NEXT_PUBLIC_STORE_REFERENCE="Em frente ao Mercado do Angu"
NEXT_PUBLIC_INSTAGRAM="@brasa.caipira"

# Fuso Horário Comercial Obrigatório
NEXT_PUBLIC_TIMEZONE="America/Sao_Paulo"

# URL da Aplicação (Local ou Produção)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
